# Rename this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Get your key at https://console.groq.com/ (API access is pay-as-you-go, see README for cost notes)
GROQ_API_KEY=your_groq_api_key_here

# Groq model this app uses by default. Check console.groq.com/docs/models for others.
GROQ_MODEL=openai/gpt-oss-120b

# Minimum score (0-1) a student needs on a quiz to unlock the next module
PASS_THRESHOLD=0.7

# Flask
FLASK_DEBUG=0
PORT=5000